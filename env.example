# GitLab Personal Access Token for private repository access
# Create your token at: https://gitlab.com/-/profile/personal_access_tokens
# Required scopes: read_repository

GITLAB_TOKEN=your_gitlab_personal_access_token_here

# Usage:
# 1. Copy this file: cp env.example .env
# 2. Replace the token with your actual GitLab Personal Access Token
# 3. Load the environment: source .env (or use direnv)
# 4. Install SDK: pip install git+https://oauth2:${GITLAB_TOKEN}@gitlab.com/dat.tram/raiki-sdk.git@v0.1.0

